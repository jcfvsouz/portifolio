<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Portfolio.Components.Messaging</PackageId>
    <Description>IEventPublisher/IEventHandler: minimal, broker-agnostic abstractions for publishing and consuming integration events, plus EventConsumer, a BackgroundService handling the generic parts of consumption (per-message DI scope, handler dispatch). Concrete brokers (RabbitMQ, SQS, ...) live in their own package and implement these.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
  </ItemGroup>

</Project>
