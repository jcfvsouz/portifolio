<Project>

  <!-- Shared settings for every project under src/. Keeps each .csproj focused on its own dependencies. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- NuGet packaging: every project here is a reusable component, packed on build and dropped into
       a local folder feed (../nupkgs) instead of published to nuget.org. Consuming apps (API/Worker)
       restore from that folder via their own nuget.config. -->
  <PropertyGroup>
    <Authors>Julio Souza</Authors>
    <PackageVersion>1.0.0</PackageVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageOutputPath>$(MSBuildThisFileDirectory)nupkgs</PackageOutputPath>
  </PropertyGroup>

</Project>
